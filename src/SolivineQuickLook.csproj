<?xml version="1.0" encoding="utf-8"?>
<!--
    翻译器（kairenzuo）项目文件

    作用：把 src\ 下的 partial class 源码、图标、离线词库、构建号组装成一个 exe。
    它和 tools\build.ps1 是「同一份配方」的两种写法，编出来的东西应当一致：
      - 目标框架 .NET Framework 4.7.2（只用到了更老的 API，4.7.2 及以上都能跑）
      - 输出 WinExe，AnyCPU，优化开启，不产出 pdb
      - 图标 assets\icons\cookie4.ico
      - 嵌入资源：OfflineDict（离线词库）、SrcRev（构建号，编译时从 git 现取）
      - 排除 src\preview_shot.cs（它自带 Main，是独立截图小工具）

    用法（二选一，任选其一即可）：
        dotnet build src\SolivineQuickLook.csproj -c Release
        powershell -ExecutionPolicy Bypass -File tools\build.ps1
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>

    <!-- 产物名字就是用户看到的 exe 名，改这里等于改交付文件名 -->
    <AssemblyName>翻译器</AssemblyName>
    <RootNamespace>SolivineQuickLook</RootNamespace>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>

    <!-- 图标直接嵌进 exe，托盘也用它 -->
    <ApplicationIcon>..\assets\icons\cookie4.ico</ApplicationIcon>

    <!-- 版本号等程序集属性写在 src\Program.cs 的 [assembly:] 里，这里不要重复生成，否则 CS0579 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- 关掉默认通配收集，改由下方显式列出，避免把 preview_shot.cs 和 obj\ 里的中间文件卷进来 -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- 框架自带程序集：和 tools\build.ps1 里 /r: 列的那一组完全对应 -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <!-- 语音识别与朗读（SpeechRecognitionEngine / SpeechSynthesizer） -->
    <Reference Include="System.Speech" />
    <!-- JSON 解析（System.Web.Script.Serialization） -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- 源码：全部 partial class 必须一起编，单独编任何一个都会报「找不到另一半」 -->
  <ItemGroup>
    <Compile Include="*.cs" Exclude="preview_shot.cs" />
  </ItemGroup>

  <!-- 离线词库：资源名固定为 OfflineDict，改这里要连同 src\Dict.cs 的 DICT_RES 一起改 -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\dict\offline_dict.txt">
      <LogicalName>OfflineDict</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
      构建号：编译时从 git 现取短提交号写进嵌入资源 SrcRev，
      程序的 SrcRev() 会读它并显示在日志/关于里。工作区有未提交改动时加 -dirty 后缀。
      取不到 git 时写 nogit，绝不编造。
  -->
  <Target Name="GenerateSrcRev" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_SrcRevFile>$(IntermediateOutputPath)src_rev.txt</_SrcRevFile>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevOut" />
    </Exec>

    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..&quot; status --porcelain"
          ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatusOut" />
    </Exec>

    <PropertyGroup>
      <_SrcRev>$([System.String]::Copy('$(_GitRevOut)').Trim())</_SrcRev>
      <_SrcRev Condition="'$(_SrcRev)' == ''">nogit</_SrcRev>
      <!-- 先把 status 的换行与空格去掉存成单独属性，条件里只做简单比较，避免 MSB4092 -->
      <_GitDirty>$([System.String]::Copy('$(_GitStatusOut)').Trim())</_GitDirty>
      <_SrcRev Condition="'$(_GitDirty)' != ''">$(_SrcRev)-dirty</_SrcRev>
    </PropertyGroup>

    <WriteLinesToFile File="$(_SrcRevFile)" Lines="$(_SrcRev)" Overwrite="true" Encoding="UTF-8" />

    <ItemGroup>
      <EmbeddedResource Include="$(_SrcRevFile)">
        <LogicalName>SrcRev</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
