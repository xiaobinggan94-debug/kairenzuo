# 编译产物，不要上传
*.exe
*.pdb
*.obj
*.ilk

# 本地密钥，绝对不要上传
apikey.txt

# 临时目录
bin/
obj/

# 手改前的备份文件，不上传
*.bak
*.bak_*
*.bak.*

# 编译测试产物
new_test.exe

# 自检/回归跑出来的结果（tools\runchecks.ps1 默认往这写）
temp/

# --version 写出来的版本小抄
version.txt

# 整理时挪走的旧产物/测试文件（保留在本地，不进版本库）
.trash-*/

# 内部开发文档，不对外发布（docs 下只放行三份对外文档）
/docs/*.md
!/docs/BUILD.md
!/docs/CHANGELOG.md
!/docs/DATA.md
/docs/*.txt
/archive/

# 编译产物与临时目录
/src/obj/
/src/bin/
/release/
